{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ultimate-tic-tac-toe",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/play/ultimate-tic-tac-toe/api/*", "/ultimate-tic-tac-toe/api/*"],
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "rw-access.dev/play/ultimate-tic-tac-toe", "zone_name": "rw-access.dev" },
    { "pattern": "rw-access.dev/play/ultimate-tic-tac-toe/*", "zone_name": "rw-access.dev" },
    { "pattern": "www.rw-access.dev/play/ultimate-tic-tac-toe", "zone_name": "rw-access.dev" },
    { "pattern": "www.rw-access.dev/play/ultimate-tic-tac-toe/*", "zone_name": "rw-access.dev" },
    { "pattern": "play.rw-access.dev/ultimate-tic-tac-toe", "zone_name": "rw-access.dev" },
    { "pattern": "play.rw-access.dev/ultimate-tic-tac-toe/*", "zone_name": "rw-access.dev" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
