{
  "name": "ultimate-tic-tac-toe",
  "version": "1.0.0",
  "packageManager": "npm@11.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-build.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && vite build --base=./ --outDir dist/play/ultimate-tic-tac-toe",
    "dev:worker": "npm run build && wrangler dev",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:worker": "npm run build && node --test tests/worker.test.mjs",
    "test:browser": "playwright test",
    "test:production": "node scripts/check-build.mjs",
    "ai:generate": "node --experimental-strip-types scripts/ai.ts generate",
    "ai:evaluate": "node --experimental-strip-types scripts/ai.ts evaluate",
    "ai:parity": "node --experimental-strip-types scripts/ai.ts parity"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.56.0",
    "onnxruntime-node": "^1.30.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  },
  "overrides": {
    "wrangler": {
      "miniflare": {
        "undici": "7.30.1"
      }
    }
  }
}
